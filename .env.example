# Supabase (required for API functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional personal-use auto sign-in (one shared account, no login screen).
# These are bundled into the client, so use a dedicated account/password only for this app.
VITE_SYNC_EMAIL=you@example.com
VITE_SYNC_PASSWORD=a-dedicated-password

# For an existing Supabase database, run
# supabase/migrations/20261101_cross_device_sync.sql in the Supabase SQL Editor.
# Never use the service-role key in the browser app.

# For local Vercel dev
# vercel env add VITE_SUPABASE_URL
# vercel env add VITE_SUPABASE_ANON_KEY