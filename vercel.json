{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "functions": {
        "api/*.ts": {
          "maxDuration": 30
        }
      }
    },
    "mcp-server": {
      "root": "mcp-server",
      "runtime": "python",
      "entrypoint": "src.habit_mcp.server:create_server"
    }
  },
  "crons": [
    { "path": "/api/daily-reminder", "schedule": "30 22 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}