{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "mcp-server": {
      "root": "mcp-server",
      "runtime": "python",
      "entrypoint": "src.habit_mcp.server:create_server"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}